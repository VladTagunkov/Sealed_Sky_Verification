# Compiler files
cache/
out/

# Ignores development broadcast logs (keep real-chain deploy receipts if you rely on them)
!/broadcast
/broadcast/*/31337/
/broadcast/**/dry-run/

# Coverage / gas reports (regenerated by `forge coverage`, snapshots)
coverage/
lcov.info
reports/
gasreport.txt

# Docs
docs/

# Secrets (never commit)
.env
.env.*
!.env.example

# Editor / OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
