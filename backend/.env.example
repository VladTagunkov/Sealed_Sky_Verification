# Optional: mirror sealed-sky-web/.env.local NameStone vars (without VITE_ prefix)
# NAMESTONE_API_KEY=
# NAMESTONE_DOMAIN=sealed-sky.eth

# Or rely on ../sealed-sky-web/_env.local or .env.local with VITE_NAMESTONE_* (loaded automatically).

# Optional: Ethereum mainnet RPC for GET /read-validation-ens (defaults to cloudflare-eth.com)
# ENS names from NameStone resolve on mainnet, not on Sepolia.
# ENS_MAINNET_RPC_URL=https://eth.llamarpc.com
